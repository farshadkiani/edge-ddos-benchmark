# استفاده از پایتون نسخه 3.10 به عنوان پایه
FROM python:3.10-slim

# تعیین پوشه کاری داخل کانتینر
WORKDIR /app

# کپی کردن لیست نیازمندی‌ها
COPY requirements.txt .

# نصب پیش‌نیازها به همراه ارتقای pip
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# کپی کردن بقیه فایل‌های پروژه (کدها و دایرکتوری دیتاست) به داخل کانتینر
COPY . .

# دستور اجرای فایل مدل
CMD ["python", "shabih_saz_6_6_1405.py"]
